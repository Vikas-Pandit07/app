# ============================================
# OUTLOOX BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill real values
# ============================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=outloox
DB_USERNAME=root
DB_PASSWORD=root

# JWT Configuration (minimum 32 chars)
JWT_SECRET=your_very_long_random_jwt_secret_key_here_change_me
JWT_EXPIRATION=3600000

# Frontend / Cookies / CORS
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
APP_COOKIE_DOMAIN=

# Demo catalog seed (dev only)
APP_SEED_DEMO_CATALOG=true

# Email Configuration (Gmail Example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=ap691869@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Server Configuration
SERVER_PORT=9090

# Rate Limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_AUTH_MAX_REQUESTS=20
SECURITY_RATE_LIMIT_PAYMENT_MAX_REQUESTS=30

# ============================================
# WARNING: Never commit a real .env file to Git
# ============================================
